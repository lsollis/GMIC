{
  "format_version": 2,
  "executors": [
    {
      "tasks": ["get_weights", "train", "validate", "test", "submit_model"],
      "executor": {
        "id": "GMICFederatedExecutor",
        "path": "bc_executor.GMICFederatedExecutor",
        "args": {
          "epochs": 40,
          "patience": 6,
          "batch_size": 32,
          "lr_heads": 3e-5,
          "lr_backbone": 3e-7,
          "weight_decay": 1e-6,
          "optimizer_name": "adam",

          "data_path": "/workspace/data/gmic_df_site1.csv",
          "image_path": "/workspace/data/p7_pngs",
          "input_format": "csv",
          "enable_preprocessing": true,
          "force_preprocessing": true,
          "cache_validation": true,
          "use_predefined_splits": true,
          "val_split": 0.15,
          "test_split": 0.15,
          "random_seed": 42,
          "output_dir": "/workspace/data/processed/local_site1",
          "num_processes": 4,

          "model_path": "/workspace/models/sample_model_5.p",
          "device": "cuda:1",

          "percent_t_key": "1",
          "lambda_l1": 1e-5,

          "method": "local",
          "fedprox_mu": 0.01,
          "ditto_lambda": 0.1,
          "lambda_global": 1.0,
          "lambda_local": 0.1,
          "lambda_fusion": null,
          "use_fedbn": false,
          "local_epochs": null,
          "pretrained_weights_path": "/workspace/models/sample_model_5.p",

          "train_log_batch_interval": 1,
          "log_lr_each_epoch": true,
          "tb_log_dir": "/workspace/tb_logs_local_site1",
          "disable_tensorboard": false,
          "per_file_logging": true,
          "tolerant_missing_metadata": false,
          "debug_devices": false,
          "use_amp": true,
          "grad_accumulation": 1,
          "memory_efficient": true,
          "gpus": "1",

          "gmic_parameters": {
            "max_crop_noise": [100, 100],
            "max_crop_size_noise": 100,
            "cam_size": [46, 30],
            "K": 6,
            "crop_shape": [256, 256],
            "post_processing_dim": 256,
            "num_classes": 2,
            "use_v1_global": false
          },

          "loss": "gmic",
          "pos_weight": 1.0,

          "use_balanced_sampler": true,
          "focal_gamma": 2.0,
          "focal_alpha": 0.25,
          "lr_scheduler": null,
          "scheduler_patience": 2,
          "min_lr": 0.0,
          "decision_threshold": 0.5,
          "eval_threshold_sweep": [0.3, 0.4, 0.5, 0.6, 0.7],
          "freeze_backbone_epochs": 2,
          "use_augmentation": false,
          "augmentation": {
            "horizontal_flip": false,
            "max_rotation_deg": 10,
            "intensity_jitter": 0.10
          },

          "log_file": "/workspace/data/processed/local_site1/executor.log",
          "file_integrity_check": true,
          "fail_on_integrity_error": false,

          "task_names": {
            "pre_train": "get_weights",
            "train": "train",
            "validate": "validate",
            "test": "test",
            "submit_model": "submit_model"
          }
        }
      }
    }
  ],
  "task_data_filters": [],
  "task_result_filters": [],
  "components": []
}